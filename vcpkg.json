{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "fh1-native",
  "version-string": "0.1.0",
  "description": "Native reimplementation of Forza Horizon (Xbox 360, 2012).",
  "builtin-baseline": "b8b8df2201ad8509b81a830fe0957bcb98e06c27",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat"
      ]
    },
    {
      "name": "fontconfig",
      "platform": "!windows"
    },
    {
      "name": "freetype",
      "default-features": false
    },
    "glm",
    {
      "name": "opengl-registry",
      "platform": "windows"
    },
    "pugixml",
    "sdl3",
    "shaderc",
    "sqlite3",
    "zlib"
  ]
}
